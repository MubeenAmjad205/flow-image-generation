{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GoogleFlowImageJob",
  "type": "object",
  "description": "Normalized job specification for Google Flow automated image generation",
  "required": [
    "project_name",
    "total_prompts",
    "default_aspect_ratio",
    "default_model",
    "images"
  ],
  "properties": {
    "project_name": {
      "type": "string",
      "minLength": 1
    },
    "source_file": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "total_prompts": {
      "type": "integer",
      "minimum": 1
    },
    "default_aspect_ratio": {
      "type": "string",
      "enum": ["16:9", "9:16", "1:1", "4:3", "3:4"],
      "default": "16:9"
    },
    "default_model": {
      "type": "string",
      "enum": ["nano_banana", "nano_banana_pro"],
      "default": "nano_banana"
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/ImagePromptSpec"
      }
    }
  },
  "definitions": {
    "ImagePromptSpec": {
      "type": "object",
      "required": [
        "sequence",
        "prompt",
        "aspect_ratio",
        "model",
        "count"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "time_code": {
          "type": ["string", "null"]
        },
        "script_cue": {
          "type": ["string", "null"]
        },
        "prompt": {
          "type": "string",
          "minLength": 5
        },
        "aspect_ratio": {
          "type": "string",
          "enum": ["16:9", "9:16", "1:1", "4:3", "3:4"]
        },
        "model": {
          "type": "string",
          "enum": ["nano_banana", "nano_banana_pro"]
        },
        "count": {
          "type": "integer",
          "enum": [1]
        },
        "metadata": {
          "type": "object",
          "properties": {
            "camera": { "type": ["string", "null"] },
            "lighting": { "type": ["string", "null"] },
            "mood": { "type": ["string", "null"] },
            "action": { "type": ["string", "null"] },
            "palette": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
